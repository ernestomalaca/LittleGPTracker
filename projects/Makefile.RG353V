# trk2als: Chancho 6 en la Anbernic RG353V (RK3566, ARM de 64 bits, 640x480)
# con ROCKNIX u otro Linux con SDL2. El mismo kit de compilación que la
# RG35XX Plus; la librería de C++ va dentro del binario
-include $(PWD)/rules_base

# config
DEFINES := \
	-DPLATFORM_$(PLATFORM) \
	-D_64BIT \
	-DBUFFERED \
	-DCPP_MEMORY \
	-DHAVE_STDINT_H \
	-D_NDEBUG \
	-D_NO_JACK_ \
	-DSDL2 \
	-DSDLAUDIO \
	-DDUMMYMIDI \
	-DFFMPEG_ENABLED \
	-DWEBSERVER \
	-DABLETON_LINK

DEVKIT := /opt/rg35xx-plus-aarch64-SDL2-SDK-0.1.0/
CROSS_COMPILE:=$(DEVKIT)bin/aarch64-none-linux-gnu-
TRIPLET:=aarch64-linux-gnu
CC = $(CROSS_COMPILE)gcc
CXX = $(CROSS_COMPILE)g++
TOOLPATH=$(DEVKIT)/usr/bin

SDL_CFLAGS  := -I/$(SYSROOT)/include -D_REENTRANT
SDL_LIBS    := -lSDL2

OPT_FLAGS = -O3 -mlittle-endian -mabi=lp64 -mcpu=cortex-a55+crypto -fasynchronous-unwind-tables -fstack-protector-strong -Wformat -Wformat-security -fstack-clash-protection -dumpbase
INCLUDES = -Iinclude $(SDL_CFLAGS) -I$(DEVKIT)/$(TRIPLET)/include -I$(DEVKIT)/$(TRIPLET)/include/c++/11/ -I$(PWD)/../sources
CFLAGS	:=	$(DEFINES) $(INCLUDES) $(OPT_FLAGS) -Wall  
CXXFLAGS:=	$(CFLAGS) -std=gnu++03 
LIBS	:= -static-libstdc++ -static-libgcc -Wl,-rpath-link,$(DEVKIT)/$(TRIPLET)/lib -Wl,-rpath-link,$(DEVKIT)/$(TRIPLET)/lib/pulseaudio $(SDL_LIBS) -lpthread

# trk2als: Ableton Link (C++17, se compila aparte; ver Services/Link)
LINK_DIR := $(PWD)/../sources/Externals/link
LinkBridge.o: CXXFLAGS := $(filter-out -std=gnu++03,$(CXXFLAGS)) -std=c++17 -DLINK_PLATFORM_LINUX=1 -I$(LINK_DIR)/include -I$(LINK_DIR)/modules/asio-standalone/asio/include
# trk2als: la reverb de los envíos es de Mutable Instruments (C++11; TEST = su versión portátil, sin ensamblador de ARM de 32 bits)
SendFx.o: CXXFLAGS := $(filter-out -std=gnu++03,$(CXXFLAGS)) -std=c++11 -DTEST -I$(PWD)/../sources/Externals/mutable
OUTPUT = ../chancho6-rg353v
EXTENSION:= elf

%.elf: $(OFILES)
	$(CXX) $(LDFLAGS) -o $@ $(OFILES) $(LIBS)
