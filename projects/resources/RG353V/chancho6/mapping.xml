<!--
    Chancho 6 en la RG353V. Los números de los botones son una SUPOSICIÓN
    (el control interno de la RK3566, "retrogame_joypad") hasta confirmarlos
    con "Detectar botones.sh". Esquema estilo LSDJ / Joy2Live.
-->
<MAPPINGS>
	<MAP src="but:0:13" dst="/event/up" />
	<MAP src="but:0:14" dst="/event/down" />
	<MAP src="but:0:15" dst="/event/left" />
	<MAP src="but:0:16" dst="/event/right" />
	<MAP src="hat:0:0:0" dst="/event/up" />
	<MAP src="hat:0:0:2" dst="/event/down" />
	<MAP src="hat:0:0:3" dst="/event/left" />
	<MAP src="hat:0:0:1" dst="/event/right" />

	<MAP src="but:0:1" dst="/event/a" />
	<MAP src="but:0:0" dst="/event/b" />
	<MAP src="but:0:2" dst="/event/x" />
	<MAP src="but:0:3" dst="/event/y" />

	<MAP src="but:0:8" dst="/event/select" />
	<MAP src="but:0:9" dst="/event/start" />

	<MAP src="but:0:4" dst="/event/lshoulder" />
	<MAP src="but:0:5" dst="/event/rshoulder" />
</MAPPINGS>
