<!--
    8BitDo SN30 Pro+ en Mac (modo B + Start), esquema estilo Joy2Live / LSDJ.
    Para ver los números de otro control: DUMPEVENT YES en config.xml.
-->
<MAPPINGS>
	<!-- cruceta -->
	<MAP src="but:0:10" dst="/event/up" />
	<MAP src="but:0:7"  dst="/event/down" />
	<MAP src="but:0:8"  dst="/event/left" />
	<MAP src="but:0:9"  dst="/event/right" />

	<!-- A / B como en LSDJ -->
	<MAP src="but:0:0" dst="/event/a" />
	<MAP src="but:0:1" dst="/event/b" />

	<!-- Start toca, Select navega (como Select + dirección en LSDJ / Joy2Live) -->
	<MAP src="but:0:3" dst="/event/start" />
	<MAP src="but:0:4" dst="/event/rshoulder" />

	<!-- L / R como en el Piggy -->
	<MAP src="but:0:11" dst="/event/lshoulder" />
	<MAP src="but:0:14" dst="/event/rshoulder" />

	<!-- libres para después: X=5, Y=6, L2=13, R2=16, Home=15 -->

	<!-- teclado (igual que antes) -->
	<MAP src="key:0:a" dst="/event/a" />
	<MAP src="key:0:s" dst="/event/b" />
	<MAP src="key:0:x" dst="/event/lshoulder" />
	<MAP src="key:0:left shift" dst="/event/rshoulder" />
	<MAP src="key:0:space" dst="/event/start" />
	<MAP src="key:0:up" dst="/event/up" />
	<MAP src="key:0:down" dst="/event/down" />
	<MAP src="key:0:left" dst="/event/left" />
	<MAP src="key:0:right" dst="/event/right" />
</MAPPINGS>
